# Normalize every text file to LF in the working tree, on every platform (including core.autocrlf=true checkouts).
# Many text files are copied byte for byte into newrelic.jar and newrelic.zip (resources, the weaver violation
# descriptions, LICENSE, sources jars), so the same commit must have the same bytes everywhere to build the same jar.
# "auto" lets git detect binary files and leave them alone. This line must stay before the overrides below
# because the last matching pattern wins.
* text=auto eol=lf

gradlew.bat eol=crlf
